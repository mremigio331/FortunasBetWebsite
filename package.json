  "main": "main.js",
  "scripts": {
    "build": "npm run generate-commit-hash && webpack --mode production",
    "start": "npm run generate-commit-hash && npm run build && node server.js",
    "dev": "npm run generate-commit-hash && webpack serve --mode development",
    "format": "prettier --write .",
    "test": "TZ=UTC jest",
    "test:watch": "TZ=UTC jest --watch",
    "test:timezones": "TZ=UTC jest && TZ=America/New_York jest && TZ=America/Los_Angeles jest && TZ=Asia/Tokyo jest",
    "generate-commit-hash": "echo \"export const commitHash = '$(git rev-parse HEAD)';\" > src/constants/gitHash.js"
  },
  "keywords": [
    "webpack",
    "react"
  ],
